{
  "expo": {
    "name": "Chvilio",
    "icon": "./assets/app-icon.png",
    "slug": "schedule-masters-mobile",
    "scheme": "schedulemasters",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F7D5C",
          "image": "./assets/launch-wordmark.png",
          "imageWidth": 150
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "cz.chvilio.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Chvilio saves the free-slots image to your photos when you choose Save Image."
      }
    },
    "extra": {
      "eas": {
        "projectId": "7c4a4737-425e-4e91-baaa-8afe91ee7378"
      }
    },
    "owner": "yd-apps-team"
  }
}
