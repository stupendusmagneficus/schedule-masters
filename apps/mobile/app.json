{
  "expo": {
    "name": "Schedule Masters Mobile",
    "slug": "schedule-masters-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "ru", "cs"],
            "android": ["en", "ru", "cs"]
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": false
    }
  }
}
