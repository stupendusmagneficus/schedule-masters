{
  "name": "schedule-masters",
  "private": true,
  "packageManager": "yarn@4.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "yarn workspace @schedule-app/api test:integration",
    "test:e2e": "playwright test && playwright test --config=playwright.mobile.config.ts",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "biome:lint": "biome lint .",
    "archify:doctor": "node .agents/skills/archify/bin/archify.mjs doctor",
    "supabase:start": "npx supabase@2.117.0 start",
    "supabase:stop": "npx supabase@2.117.0 stop",
    "supabase:status": "npx supabase@2.117.0 status",
    "supabase:reset": "npx supabase@2.117.0 db reset",
    "supabase:types": "npx supabase@2.117.0 gen types typescript --local --schema public | sed '${/^$/d;}' > packages/api/src/supabase/database.types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.11.0",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
